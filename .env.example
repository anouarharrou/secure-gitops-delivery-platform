# Local-only service ports. All host bindings default to loopback.
JENKINS_HTTP_PORT=8080
REGISTRY_HTTP_PORT=5000

# Toolchain pins used by the local lab.
JENKINS_IMAGE=jenkins/jenkins:2.591-jdk21
BUILDKIT_IMAGE=moby/buildkit:v0.35.0-rootless
REGISTRY_IMAGE=registry:3

# Leave defaults unless you intentionally need different ports.
